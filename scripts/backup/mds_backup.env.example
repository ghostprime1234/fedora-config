# ==============================================================================
# MDS BACKUP CONFIGURATION TEMPLATE
#

# Copy this file to:
# mds_backup.env
#

# Then replace the example values with settings for the current machine.
# Do not commit mds_backup.env because it contains machine-specific paths,
# usernames, hostnames, and SSH key locations.

# ==============================================================================
# ------------------------------------------------------------------------------

# LOCAL PATHS

# ------------------------------------------------------------------------------

# Directory whose contents will be synchronised and backed up.
# Do not add an extra directory name to rsync commands; the backup script handles
# trailing slashes when copying directory contents.

SOURCE="/path/to/local/University"

# Local directory used for daily snapshots and weekly full archives.
SNAPSHOT_ROOT="/path/to/local/University/snapshots"

# Root directory of the mounted USB backup vault.
LOCAL_VAULT="/path/to/mounted/University_Vault"

# rsync exclusion rules.
EXCLUDES="$HOME/scripts/backup/rsync-excludes.txt"

# File updated after a successful backup and synchronisation run.
STATUS_FILE="/path/to/local/University/sync_status.txt"

# ------------------------------------------------------------------------------
# REMOTE SSH
# ------------------------------------------------------------------------------

REMOTE_USER="your_username"
REMOTE_HOST="your-remote-hostname"
SSH_KEY="$HOME/.ssh/your_private_key"

# Root directory on the remote machine.
REMOTE_PATH="/home/your_username/University"

# ------------------------------------------------------------------------------
# REMOTE AUTOMATION
# ------------------------------------------------------------------------------

# Script started on the remote machine after the main synchronisation completes.
REMOTE_SYNC_SCRIPT="/home/your_username/scripts/global_lab_sync.sh"

# ------------------------------------------------------------------------------
# SNAPSHOT RETENTION
# ------------------------------------------------------------------------------

# Number of days to retain daily hard-link snapshots.
DAILY_RETENTION_DAYS=7

# Number of days to retain weekly compressed full archives.
FULL_RETENTION_DAYS=90
